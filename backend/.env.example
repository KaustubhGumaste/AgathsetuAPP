APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-password
DATABASE_URL=sqlite:///backend/data/aghatsethu.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_TTL_MINUTES=60
BOOTSTRAP_ADMIN_EMAIL=admin@trafficops.blr.gov.in
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
CARLA_SHARED_SECRET=replace-with-a-separate-random-service-secret
VISION_SHARED_SECRET=replace-with-a-separate-random-service-secret
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MAX_VIDEO_BYTES=524288000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Signup email verification (6-digit code). Use a Gmail account with 2-Step Verification on and an
# App password (Google Account > Security > App passwords), never the normal Gmail password.
# When SMTP_USERNAME and SMTP_PASSWORD are set, new accounts must confirm their email first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# EMAIL_OTP_REQUIRED=true   # refuse signups until mail is configured

# Google sign-in: the Web OAuth client ID(s) whose ID tokens are accepted (comma separated). Must
# include the value the app is built with as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID. Empty = Google off.
GOOGLE_CLIENT_IDS=
# Driving route on the authority accident map (Google Routes API, server key; keep it secret).
# Empty = the map shows the straight-line direction and a turn-by-turn button instead.
GOOGLE_ROUTES_API_KEY=
# Map position of each junction: "ID:latitude:longitude" separated by ";". The built-in values for
# J01-J03 are placeholder points in Bengaluru for the simulated junctions.
# JUNCTION_COORDINATES=J01:12.9177:77.6238;J02:13.0358:77.5970;J03:13.0075:77.6950
