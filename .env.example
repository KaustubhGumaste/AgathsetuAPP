EXPO_PUBLIC_API_URL=https://your-fastapi-host.example.com

# Google sign-in: the *Web* OAuth client ID (Google Cloud > APIs & Services > Credentials).
# Also create an *Android* OAuth client with package com.aghatsethu.mobile and the build's SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Maps SDK for Android key for the in-app accident map (restrict it to the app's package + SHA-1).
GOOGLE_MAPS_ANDROID_API_KEY=
# iOS only: reversed iOS OAuth client ID, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=
